//- Hand-drawn 24×24 stroke icons (no runtime dependency).
mixin icon(name)
  svg.icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")&attributes(attributes)
    case name
      when 'mic'
        rect(x="9" y="2" width="6" height="12" rx="3")
        path(d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3")
      when 'mic-off'
        rect(x="9" y="2" width="6" height="12" rx="3")
        path(d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M3 3l18 18")
      when 'video'
        rect(x="2" y="6" width="14" height="12" rx="2")
        path(d="m16 10 6-3v10l-6-3z")
      when 'video-off'
        rect(x="2" y="6" width="14" height="12" rx="2")
        path(d="m16 10 6-3v10l-6-3zM3 3l18 18")
      when 'screen'
        rect(x="2" y="3" width="20" height="14" rx="2")
        path(d="M8 21h8M12 17v4M12 13V7m-3 3 3-3 3 3")
      when 'screen-off'
        rect(x="2" y="3" width="20" height="14" rx="2")
        path(d="M8 21h8M12 17v4M9 7l6 6M15 7l-6 6")
      when 'settings'
        path(d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1")
        circle(cx="15" cy="6" r="2")
        circle(cx="9" cy="12" r="2")
        circle(cx="17" cy="18" r="2")
      when 'leave'
        path(d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9")
      when 'chevron-down'
        path(d="m6 9 6 6 6-6")
      when 'chevron-right'
        path(d="m9 6 6 6-6 6")
      when 'sparkles'
        path(d="m12 3 1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4z")
        path(d="m19 15 .7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z")
      when 'layout'
        rect(x="3" y="3" width="7" height="7" rx="1")
        rect(x="14" y="3" width="7" height="7" rx="1")
        rect(x="3" y="14" width="7" height="7" rx="1")
        rect(x="14" y="14" width="7" height="7" rx="1")
      when 'record'
        circle(cx="12" cy="12" r="8")
        circle.icon-fill(cx="12" cy="12" r="4" fill="currentColor" stroke="none")
      when 'x'
        path(d="M18 6 6 18M6 6l12 12")
      when 'user'
        circle(cx="12" cy="8" r="4")
        path(d="M4 21a8 8 0 0 1 16 0")
      when 'keyboard'
        rect(x="2" y="6" width="20" height="12" rx="2")
        path(d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10")
      when 'image'
        rect(x="3" y="3" width="18" height="18" rx="2")
        circle(cx="9" cy="9" r="2")
        path(d="m21 15-5-5L5 21")
      when 'volume'
        path(d="M11 5 6 9H2v6h4l5 4z")
        path(d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14")
      when 'chart'
        path(d="M3 3v18h18M7 16v-5M12 16V8M17 16V9")
      when 'download'
        path(d="M12 3v12M7 10l5 5 5-5M5 21h14")
      when 'alert'
        path(d="M12 3 2 21h20zM12 10v4M12 18h.01")
      when 'link-off'
        path(d="M9 17H7a5 5 0 0 1 0-10h2M15 7h2a5 5 0 0 1 4 8M8 12h3M3 3l18 18")
      when 'check'
        path(d="m5 12 5 5L20 7")
      when 'refresh'
        path(d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5")
      default
        circle(cx="12" cy="12" r="9")
