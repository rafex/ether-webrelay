//- Labelled select; options are filled at runtime when `options` is empty.
mixin select(id, label, options)
  .field
    label(for=id)= label
    .select
      select(id=id name=id)&attributes(attributes)
        if options
          each text, value in options
            option(value=value)= text
      +icon('chevron-down')

mixin switch(id, label, hint)
  label.switch(for=id)
    input(id=id name=id type="checkbox" role="switch")&attributes(attributes)
    span.switch-track(aria-hidden="true")
    span.switch-label
      = label
      if hint
        small.hint= hint

mixin text(id, label, placeholder, maxlength)
  .field
    label(for=id)= label
    input(id=id name=id type="text" placeholder=placeholder maxlength=maxlength autocomplete="off")&attributes(attributes)
