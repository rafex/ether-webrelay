include ../mixins/form.pug

form#relay-form.panel(novalidate autocomplete="off")
  fieldset
    legend Puente
    +field('bridgeUrl', 'URL del puente (wss://)', 'url')(placeholder="wss://bridge.example.com/relay" required)
      | Solo wss://; ws:// se permite únicamente para localhost.
    +field('token', 'Token de acceso', 'password')(placeholder="opcional")
  fieldset
    legend Destino RTMPS (opcional)
    +field('destinationUrl', 'URL de ingesta', 'url')(placeholder="rtmps://a.rtmps.youtube.com/live2")
      | Déjalo vacío si el puente ya conoce el destino.
    +field('streamKey', 'Clave de stream', 'password')
  fieldset
    legend Fuentes
    .toggles
      +toggle('camera', 'Cámara', true)
      +toggle('microphone', 'Micrófono', true)
      +toggle('screen', 'Pantalla', false)
      +toggle('systemAudio', 'Audio del sistema/pestaña', false)
  fieldset
    legend Codificación
    .grid
      +select('resolution', 'Resolución', {'640x360': '360p', '1280x720': '720p', '1920x1080': '1080p'}, '1280x720')
      +select('framerate', 'FPS', {'24': '24', '30': '30', '60': '60'}, '30')
      +field('videoBitrate', 'Video kbps', 'number')(value="2500" min="100" max="20000" step="100")
      +select('videoCodec', 'Códec de video', {h264: 'H.264 (preferido)', vp8: 'VP8'}, 'h264')
      +field('audioBitrate', 'Audio kbps', 'number')(value="128" min="32" max="320" step="16")
      +select('audioCodec', 'Códec de audio', {aac: 'AAC (preferido)', opus: 'Opus'}, 'aac')
      +field('keyframeInterval', 'Keyframe cada (s)', 'number')(value="2" min="0.5" max="10" step="0.5")
  ul#form-errors.errors(role="alert" hidden)
  .actions
    button#start(type="submit") Iniciar transmisión
    button#stop(type="button" disabled) Detener
