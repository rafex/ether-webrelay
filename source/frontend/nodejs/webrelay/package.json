{
  "name": "@ether/webrelay",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-side relay: captures camera, microphone and screen, encodes with WebCodecs and streams to an Ether WebRelay bridge over WebSocket.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "bridge:dev": "node tests/support/dev-bridge.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/pug": "2.0.10",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.4",
    "pug": "3.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "werift": "0.24.4",
    "ws": "8.22.0"
  }
}
