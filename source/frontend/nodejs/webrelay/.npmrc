# Ninguna dependencia necesita scripts de instalación (los binarios de esbuild/rolldown/biome/sharp
# llegan como paquetes opcionales por plataforma; los navegadores de Playwright se instalan aparte).
# Así `npm ci` no ejecuta código de terceros: @huggingface/transformers arrastra onnxruntime-node y
# protobufjs, que sí traen postinstall y no se usan en el navegador.
ignore-scripts=true
