# containers/ci/Containerfile — imagen de CI con el toolchain fijo (reglas 06 y 08).
#
# Ejecuta la cadena install + lint + build + test dentro del contenedor:
#   make image   → construye esta imagen
#   make ci      → corre `make install lint build test` con el repo montado
#
# Base: Alpine con Node.js 24 LTS, fijada por digest del índice multi-arch.
FROM docker.io/library/node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

RUN apk add --no-cache bash make git ca-certificates tzdata

ENV CI=true \
    npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false

WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["make help"]
